{
  "name": "partly",
  "version": "1.0.2",
  "description": "Partly: a preset to mask converter for Lightroom. Converts Lightroom presets into presets that apply the look inside an AI mask (background, subject, sky, people, landscape).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "bin": {
    "partly": "cli/partly.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "serve": "node scripts/serve.mjs",
    "build:mac": "scripts/build-mac-app.sh",
    "selftest:mac": "dist/Partly.app/Contents/MacOS/Partly --selftest",
    "samples": "node scripts/make-samples.mjs",
    "icon": "node scripts/make-icon.mjs",
    "docs": "node scripts/capture-docs.mjs"
  }
}
